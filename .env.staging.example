# =========================================================================
# HOMESTEPIN — STAGING ENVIRONMENT CONFIGURATION (.env.staging.example)
# =========================================================================
# Deployment target: Render Web Service + Netlify + MongoDB Atlas
#
# Copy this to .env on your local machine for testing, OR set these as
# environment variables in the Render Dashboard for staging deployment.
#
# NEVER commit real secret values to Git.
# =========================================================================

# ── Application Core ────────────────────────────────────────────────────
NODE_ENV=staging
# PORT — Do NOT set this on Render. Render injects PORT automatically.
# For local development, uncomment the line below:
# PORT=4001
PUBLIC_BASE_URL=https://homestepin-staging.onrender.com

# ── Database (Dedicated Staging MongoDB Atlas Cluster) ──────────────────
# WARNING: MUST be a distinct staging database — NEVER point to production!
MONGODB_URI=mongodb+srv://<staging_user>:<staging_password>@cluster0.xxxxx.mongodb.net/homestepin_staging?retryWrites=true&w=majority

# ── Authentication Secrets ──────────────────────────────────────────────
# Generate with: openssl rand -base64 48 (minimum 32 characters each)
JWT_ACCESS_SECRET=replace_with_min_32_characters_random_staging_access_secret
JWT_REFRESH_SECRET=replace_with_min_32_characters_random_staging_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
OTP_SECRET=replace_with_min_32_characters_random_staging_otp_secret

# ── Admin Bootstrap Credentials ────────────────────────────────────────
ADMIN_BOOTSTRAP_EMAIL=admin@staging.homestepin.com
ADMIN_BOOTSTRAP_PASSWORD=StrongStagingAdminPass2026!

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed web origins (your Netlify admin URL)
CORS_ALLOWED_ORIGINS=https://homestepin-admin-staging.netlify.app

# ── Razorpay Sandbox (TEST MODE ONLY — Zero Real Money) ─────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_test_webhook_secret
PAYMENT_WEBHOOK_SECRET=replace_with_razorpay_test_webhook_secret

# ── Email Delivery (Resend Sandbox) ─────────────────────────────────────
RESEND_API_KEY=re_test_xxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=HomeStepIn Staging <onboarding@resend.dev>

# ── File Storage & Geolocation ──────────────────────────────────────────
UPLOAD_MAX_MB=8
ENTER_HOME_MAX_METERS=180
