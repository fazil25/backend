PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/homestepin
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
PAYMENT_WEBHOOK_SECRET=replace-with-payment-webhook-secret
ADMIN_BOOTSTRAP_EMAIL=admin@homestepin.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe_Admin_1
PUBLIC_BASE_URL=http://127.0.0.1:4000
# Comma-separated browser origins. Required in production, for example:
# CORS_ALLOWED_ORIGINS=https://admin.homestepin.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required in production. Never expose RAZORPAY_KEY_SECRET to clients.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Gmail password-reset OTP delivery. Create Google OAuth credentials with the
# gmail.send scope and store these only in your production secret manager.
GMAIL_SENDER_EMAIL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
UPLOAD_MAX_MB=8
ENTER_HOME_MAX_METERS=180

# Mappls (MapmyIndia) Server-Side REST API Credentials
# Obtain from Mappls Developer Console (https://apis.mappls.com/console/ -> Credentials / API Keys)
#
# Option A (Standard OAuth 2.0 Server Credentials - Recommended):
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
#
# Option B (Static REST API Key / Token):
MAPPLS_API_KEY=

# Resend Email Delivery & OTP Authentication Configuration
# Sign up at https://resend.com to obtain your API key.
# For free onboarding testing, RESEND_FROM_EMAIL defaults to onboarding@resend.dev (sends to your account email).
# For production arbitrary recipient delivery, verify your custom domain in Resend domains dashboard.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=HomeStepIn <onboarding@resend.dev>
OTP_SECRET=your_long_random_secret_at_least_32_characters

NODE_ENV=development
